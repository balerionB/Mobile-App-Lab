<?xml version="1.0" encoding="utf-8"?>
<!-- Practical 2 layout + callButton inside the "Just added" group. Compare with your own copy. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="tenant"
            type="com.example.lab1.Tenant" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <TextView
            android:id="@+id/justAddedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Just added"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/newTenantTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@{tenant.summary()}"
            android:padding="16dp"
            android:background="#E8EEF7"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/justAddedLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/callButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CALL TENANT"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/newTenantTextView"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- One Group hides/shows all three "Just added" views together -->
        <androidx.constraintlayout.widget.Group
            android:id="@+id/newTenantGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="justAddedLabel,newTenantTextView,callButton" />

        <TextView
            android:id="@+id/allTenantsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All tenants"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/callButton"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/allTenantsTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="No tenants yet."
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/allTenantsLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>